# これは「見本」です。実際の鍵は書かないでください。
# 本番（Streamlit Cloud）では、この形で管理画面の Secrets に貼り付けます。
# ローカルでスプレッドシート接続を試したいときだけ、同じフォルダに
# secrets.toml という名前でコピーし、中身を本物に差し替えてください。
# （secrets.toml は .gitignore でGitHubに上がらないようにしてあります）

[gcp_service_account]
type = "service_account"
project_id = "あなたのプロジェクトID"
private_key_id = "xxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\n（鍵の中身）\n-----END PRIVATE KEY-----\n"
client_email = "xxxxx@xxxxx.iam.gserviceaccount.com"
client_id = "000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/xxxxx"
